  "operatingFlags": [
    {
      "name": "programmingLock",
      "label": "Programming lock",
      "section": "Linking",
      "description": "Linking and programming from the device itself are locked out.",
      "query": "0x00",
      "bit": "0x01",
      "on": "0x00",
      "off": "0x01"
    },
    {
      "name": "ledOnTransmit",
      "label": "Blink LED when sending",
      "section": "LEDs",
      "description": "The status LED blinks when the device sends an Insteon message.",
      "query": "0x00",
      "bit": "0x02",
      "on": "0x02",
      "off": "0x03"
    },
    {
      "name": "resumeDim",
      "label": "Resume dim",
      "section": "Load",
      "description": "Turning the load on at the device restores its last level instead of the on-level.",
      "query": "0x00",
      "bit": "0x04",
      "on": "0x04",
      "off": "0x05"
    },
    {
      "name": "ledOff",
      "label": "LED off",
      "section": "LEDs",
      "description": "The status LED is off.",
      "query": "0x00",
      "bit": "0x10",
      "on": "0x08",
      "off": "0x09",
      "verification": {
        "status": "conflicting",
        "note": "The Insteon Developer's Guide reads bit 4 of the 0x00 reply as LED on, but later sources read it as LED off, the state 0x08 sets."
      }
    },
    {
      "name": "loadSense",
      "label": "Load sense",
      "section": "Load",
      "description": "Load sense is on: the device turns its load on when it senses the attached lamp or appliance being switched on.",
      "query": "0x00",
      "bit": "0x20",
      "on": "0x06",
      "off": "0x07"
    },
    {
      "name": "cleanupReport",
      "label": "Send cleanup reports",
      "section": "Communication",
      "advanced": true,
      "description": "The device sends a success report after the cleanup messages that follow a group command. Only dealer firmware has this setting.",
      "query": "0x00",
      "bit": "0x40"
    }
  ],
  "readings": [
    {
      "name": "databaseDelta",
      "label": "ALL-Link database changes",
      "section": "Diagnostics",
      "advanced": true,
      "description": "A count that goes up whenever the ALL-Link database changes.",
      "query": "0x01"
    },
    {
      "name": "signalToNoise",
      "label": "Signal-to-noise",
      "section": "Diagnostics",
      "advanced": true,
      "description": "The powerline's signal-to-noise value.",
      "query": "0x02"
    }
  ],
  "flagCommands": [
    {
      "name": "cleanupReportOff",
      "description": "Turns cleanup success reports off.",
      "command2": "0x0A"
    },
    {
      "name": "cleanupReportOn",
      "description": "Turns cleanup success reports on.",
      "command2": "0x0B"
    }
  ],
  "extendedSettings": {
    "perButton": false,
    "values": [
      {
        "name": "ledDimming",
        "label": "LED dimming",
        "section": "LEDs",
        "description": "How much the status LED is dimmed: 0x00 is no dimming (brightest), 0x01 the most dimming and 0xFF the least.",
        "byte": 3,
        "range": {
          "from": "0x00",
          "through": "0xFF"
        },
        "advanced": true
      },
      {
        "name": "x10HouseCode",
        "label": "X10 house code",
        "section": "X10",
        "advanced": true,
        "description": "The X10 house code, or 0x20 for no X10 address.",
        "byte": 5
      },
      {
        "name": "x10UnitCode",
        "label": "X10 unit code",
        "section": "X10",
        "advanced": true,
        "description": "The X10 unit code.",
        "byte": 6
      },
      {
        "name": "rampRate",
        "label": "Ramp rate",
        "section": "Load",
        "description": "The ramp rate, from 0x01 (8 minutes) to 0x1F (0.1 second). 0x00 is 2 seconds.",
        "byte": 7,
        "range": {
          "from": "0x00",
          "through": "0x1F"
        },
        "table": "rampRate",
        "verification": {
          "status": "conflicting",
          "note": "Earlier sources give ramp rate 0x00 as 9 minutes; the table uses the later reading, 2 seconds."
        }
      },
      {
        "name": "onLevel",
        "label": "On-level",
        "section": "Load",
        "description": "The level the load turns on to, from 0x00 (off) to 0xFF (full).",
        "byte": 8,
        "range": {
          "from": "0x00",
          "through": "0xFF"
        },
        "unit": "percent",
        "scale": 0.392157
      },
      {
        "name": "signalToNoiseThreshold",
        "label": "Signal-to-noise threshold",
        "section": "Diagnostics",
        "advanced": true,
        "description": "The signal-to-noise threshold.",
        "byte": 9
      },
      {
        "name": "signalToNoiseCount",
        "label": "Signal-to-noise count",
        "section": "Diagnostics",
        "advanced": true,
        "description": "The signal-to-noise count.",
        "byte": 12
      },
      {
        "name": "signalToNoiseLastFailure",
        "label": "Last signal-to-noise failure",
        "section": "Diagnostics",
        "advanced": true,
        "description": "The signal-to-noise value of the last failure.",
        "byte": 13
      }
    ],
    "writes": [
      {
        "name": "x10Address",
        "description": "Sets the X10 address.",
        "selector": "0x04",
        "perButton": false,
        "bytes": [
          {
            "position": 3,
            "value": "x10HouseCode"
          },
          {
            "position": 4,
            "value": "x10UnitCode"
          }
        ]
      },
      {
        "name": "rampRate",
        "description": "Sets the ramp rate.",
        "selector": "0x05",
        "perButton": false,
        "bytes": [
          {
            "position": 3,
            "value": "rampRate"
          }
        ]
      },
      {
        "name": "onLevel",
        "description": "Sets the on-level.",
        "selector": "0x06",
        "perButton": false,
        "bytes": [
          {
            "position": 3,
            "value": "onLevel"
          }
        ]
      }
    ]
  },
  "standardCommands": [
    {
      "name": "lightOn",
      "description": "Turns the load on to the level in cmd2 at the saved ramp rate.",
      "command1": "0x11",
      "parameter": {
        "name": "onLevel",
        "description": "The level to go to, from 0x00 (off) to 0xFF (full).",
        "range": {
          "from": 0,
          "through": 255
        }
      }
    },
    {
      "name": "lightOff",
      "description": "Turns the load off at the saved ramp rate.",
      "command1": "0x13"
    },
    {
      "name": "readStatus",
      "description": "Reads the load's level. The acknowledgment's cmd1 carries the ALL-Link database delta.",
      "command1": "0x19",
      "command2": "0x00",
      "reply": {
        "name": "onLevel",
        "description": "The load's level, from 0x00 (off) to 0xFF (full)."
      }
    }
  ],
  "groupTypes": [
    {
      "name": "light",
      "label": "Light",
      "kind": "dimmer",
      "state": {
        "command": "readStatus"
      },
      "actions": [
        {
          "name": "on",
          "label": "On",
          "command": "lightOn"
        },
        {
          "name": "off",
          "label": "Off",
          "command": "lightOff"
        }
      ]
    }
  ],
  "notes": [
    "The Insteon Developer's Guide lists 0x0A and above as unused on this code base; later sources add the cleanup report commands 0x0A and 0x0B.",
    "Earlier sources give ramp rates 0x00 through 0x1F as 9 minutes down to 0.1 second; the later ones make 0x01 8 minutes and 0x00 2 seconds.",
    "Earlier sources give D12 as the signal-to-noise ratio and D13 as a count of messages with CRC errors."
  ],
  "sources": [
    "Insteon Developer's Guide (2009)"
  ]
}
