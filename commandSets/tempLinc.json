  "standardCommands": [
    {
      "name": "raiseSetpoint",
      "description": "Raises the setpoint.",
      "command1": "0x68",
      "parameter": {
        "name": "change",
        "description": "How far to raise it.",
        "scale": 0.5,
        "unit": "displayDegrees"
      }
    },
    {
      "name": "lowerSetpoint",
      "description": "Lowers the setpoint.",
      "command1": "0x69",
      "parameter": {
        "name": "change",
